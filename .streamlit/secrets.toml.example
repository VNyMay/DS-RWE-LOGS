# Copy this file to .streamlit/secrets.toml (which is git-ignored) and fill it in.
# On Streamlit Community Cloud, paste the same keys into the app's "Secrets" settings.

# Password for the Admin / Review page. Required for moderation.
ADMIN_PASSWORD = "change-me-to-a-long-random-password"

# Optional. Leave out to use the local SQLite file in data/examples.db.
# For Supabase / PostgreSQL use the connection string from the Supabase dashboard:
# DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
